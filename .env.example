# Development defaults. Production values must be injected outside the repo.
DATABASE_URL=postgresql://kanei:local_only_dev@127.0.0.1:5434/kanei_crm_mvp
API_HOST=127.0.0.1
API_PORT=3081
WEB_HOST=127.0.0.1
WEB_PORT=3080

# Private document storage (required for API startup).
DOCUMENT_STORAGE_DIR=

# Exact browser origins allowed in addition to the API's own Host origin.
# ALLOWED_ORIGINS=https://crm.example.invalid

# Trust X-Forwarded-For only from these socket-peer networks.
# TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# Web relay: set to 1 only when Caddy supplies the client IP and the Next relay
# forwards it to the API. Without this, all browser logins share one socket IP.
# KANEI_WEB_BEHIND_TRUSTED_PROXY=1

# WEB_ALLOWED_ORIGINS=https://crm.example.invalid
